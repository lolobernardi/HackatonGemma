# Copiar a .env en la raíz del proyecto.

# --- Ollama / Gemma ---
# IMPORTANTE: MODELO tiene que coincidir EXACTO con un tag de `ollama list` en
# ESTA computadora. /health compara el string literal y devuelve 503 si no está.
# Cada equipo suele tener bajado un tamaño distinto (e2b, 12b, ...).
OLLAMA_URL=http://localhost:11434
MODELO=gemma4:12b
TIMEOUT_GEMMA_S=180
OLLAMA_KEEP_ALIVE=10m

# Dejar en false en los tags con capacidad de "thinking": si razonan en voz
# alta no emiten la tool call y todos los turnos terminan en error_seguro.
GEMMA_THINK=false

# --- Base de centros de salud ---
# La levanta el proyecto hermano centros_salud_db con .\start_db.ps1.
# Si no está disponible, el triaje sigue funcionando: sólo se pierde la
# sugerencia de a qué centro ir.
CENTROS_DB_URL=postgresql+psycopg2://postgres@127.0.0.1:5438/centros_salud
CENTROS_DB_TIMEOUT_S=5
MAX_CENTROS_SUGERIDOS=3

# Dónde está la persona. La base sólo cubre Paraná y Santa Fe capital, así que
# Oro Verde se busca en Paraná y se le avisa a la persona en el mensaje final.
CIUDAD_PACIENTE=Oro Verde

# --- Demo ---
# true permite que Streamlit muestre la ficha estructurada en la barra lateral.
# No usar con datos reales ni en un despliegue público.
DEBUG_MODE=true

# --- Conversación ---
MAX_PREGUNTAS=10
MAX_TURNOS=16
HISTORIAL_TURNOS=6
SESION_TTL_MINUTOS=30

# Gemma no decide la clasificación; esta opción solo reescribe el mensaje final.
REDACCION_LLM=false
