# Copiar a .env y ajustar. Las variables ya definidas en el entorno tienen
# prioridad sobre este archivo.

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
MODELO=gemma4:e4b

# --- Comportamiento ---
# Expone la ficha clínica en el campo `debug` de la respuesta.
# Sirve para mostrarle al jurado cómo se fue llenando. NO prender en producción.
DEBUG_MODE=false

# Máximo de preguntas de aclaración antes de clasificar con lo que haya.
MAX_PREGUNTAS=3

# Máximo de turnos de conversación antes de forzar el cierre.
MAX_TURNOS=8

# Turnos del historial que se le reenvían al modelo en cada llamada.
HISTORIAL_TURNOS=6

# Minutos de inactividad tras los cuales se borra la sesión.
SESION_TTL_MINUTOS=30

# Segunda llamada al modelo para redactar más lindo el mensaje final.
# El color y el motivo ya vienen decididos; si falla, se usa la plantilla.
REDACCION_LLM=false
